<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources></RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\runtime\native\ps5rt_runner.cpp"
          Link="runtime\native\ps5rt_runner.cpp"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\native\ps5runtime.cpp"
          Link="runtime\native\ps5runtime.cpp"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\native\ps5rt_api.h"
          Link="runtime\native\ps5rt_api.h"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\native\ps5gpu_bridge_api.h"
          Link="runtime\native\ps5gpu_bridge_api.h"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\native\auto_resolver.h"
          Link="runtime\native\auto_resolver.h"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\native\ps5rt_hle_impl.cpp"
          Link="runtime\native\ps5rt_hle_impl.cpp"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\native\ps5rt_hle_impl.h"
          Link="runtime\native\ps5rt_hle_impl.h"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtime\native\ps5rt_shared.h"
          Link="runtime\native\ps5rt_shared.h"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
